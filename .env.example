# Persistent local PGlite database and uploaded files
STORAGE_DIR=./storage
# Public base URL, also used as the Google OAuth callback base
APP_URL=http://localhost:3000
# Show the Google sign-in button only when explicitly enabled
SHOW_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set false only when running production locally over HTTP
COOKIE_SECURE=false
